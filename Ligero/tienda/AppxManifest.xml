<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifiesto del paquete MSIX de Ligero para la Microsoft Store.
  Los valores entre llaves los rellena empaquetar.ps1 a partir de identidad.txt.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop6 rescap">

  <Identity Name="{NOMBRE}" Publisher="{EDITOR}" Version="{VERSION}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Ligero</DisplayName>
    <PublisherDisplayName>{NOMBRE_EDITOR}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Ligero cambia ajustes de Windows y limpia archivos del usuario: necesita que esos cambios
         sean reales y no queden en una copia privada del paquete. -->
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es" />
  </Resources>

  <Applications>
    <Application Id="Ligero" Executable="Ligero.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Ligero"
        Description="Optimizador para equipos con pocos recursos. Explica cada función y casi todo se puede deshacer."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Arranque con Windows: desactivado hasta que el usuario lo active desde Ligero. -->
        <uap5:Extension Category="windows.startupTask" Executable="Ligero.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="LigeroInicio" Enabled="false" DisplayName="Ligero" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- Algunos ajustes (servicios, hibernación) piden permisos de administrador. -->
    <rescap:Capability Name="allowElevation" />
    <!-- Necesaria para desactivar la virtualización declarada arriba. -->
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
